# das_embed_file(<target> <file> <name>): builds <file> into <target> as
#     extern const unsigned char <name>[];  extern const std::size_t <name>Size;
# so the program needs no separate data files (the font, for example).
function(das_embed_file target file name)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Some line breaks, so compilers and editors stay happy.
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
    set(out "${CMAKE_CURRENT_BINARY_DIR}/embedded/${name}.cpp")
    file(CONFIGURE OUTPUT "${out}" CONTENT
"// Generated by cmake/DasEmbed.cmake from ${file}. Do not edit.
#include <cstddef>
extern const unsigned char ${name}[] = {
${bytes}
};
extern const std::size_t ${name}Size = ${size};
" @ONLY)
    target_sources(${target} PRIVATE "${out}")
endfunction()
